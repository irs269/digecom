{
  "name": "digecom-platform",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:shared": "pnpm --filter @digecom/shared build",
    "lint": "pnpm -r --parallel lint && prettier --check . && pnpm -r typecheck",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "test": "pnpm --filter @digecom/shared test && pnpm --filter api test && pnpm --filter api test:e2e && pnpm --filter mobile test",
    "e2e": "pnpm --filter web e2e",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@digecom/config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "@nestjs/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}

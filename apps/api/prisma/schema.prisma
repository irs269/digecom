// Schéma Prisma – Dig'eCom. Guide : docs/DATA-MODEL.md
// Montants en Int (KMF). Identifiants cuid(). Dates en UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FINANCE_MANAGER
  ACCOUNTANT
  ACCOUNTANT_ASSISTANT
  CASHIER
  STOCK_MANAGER
  LOGISTICS_ASSISTANT
  LEADER_SENIOR
  LEADER_JUNIOR
  TELECONSULTANT
  SELLER
  COURIER
}

enum IslandCode {
  GC
  AN
  MO
}

enum SiteType {
  SHOP
  WAREHOUSE
}

model Island {
  id        String     @id @default(cuid())
  code      IslandCode @unique
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  sites         Site[]
  users         User[]
  orders        Order[]
  ledgerEntries LedgerEntry[]
  settlements   Settlement[]
  expenses      Expense[]
}

model Site {
  id        String   @id @default(cuid())
  name      String   @unique
  type      SiteType
  islandId  String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  island Island @relation(fields: [islandId], references: [id])
  users  User[]

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  lots           Lot[]
  purchaseOrders PurchaseOrder[]
  inventories    Inventory[]
  stockAlerts    StockAlert[]
  orders         Order[]
  cashRegister   CashRegister?

  @@index([islandId])
}

model User {
  id                 String    @id @default(cuid())
  fullName           String
  phone              String    @unique
  email              String?   @unique
  passwordHash       String
  role               Role
  islandId           String?
  siteId             String?
  /// Leader de rattachement (SELLER, TELECONSULTANT)
  leaderId           String?
  isActive           Boolean   @default(true)
  /// Disponibilité (COURIER)
  isAvailable        Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  island        Island?        @relation(fields: [islandId], references: [id])
  site          Site?          @relation(fields: [siteId], references: [id])
  leader        User?          @relation("LeaderTeam", fields: [leaderId], references: [id])
  team          User[]         @relation("LeaderTeam")
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  settings      Setting[]

  teamHistory       TeamAssignmentHistory[] @relation("AssignmentUser")
  leftTeams         TeamAssignmentHistory[] @relation("AssignmentFromLeader")
  joinedTeams       TeamAssignmentHistory[] @relation("AssignmentToLeader")
  assignmentsMadeBy TeamAssignmentHistory[] @relation("AssignmentBy")

  products           Product[]       @relation("LeaderProducts")
  productsCreated    Product[]       @relation("ProductCreatedBy")
  stockMovements     StockMovement[] @relation("StockMovementBy")
  purchaseOrders     PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  inventoriesStarted Inventory[]     @relation("InventoryStartedBy")
  inventoriesClosed  Inventory[]     @relation("InventoryClosedBy")

  ordersAsSeller  Order[]                @relation("OrderSeller")
  ordersAsLeader  Order[]                @relation("OrderLeader")
  ordersAsCourier Order[]                @relation("OrderCourier")
  ordersOnBehalf  Order[]                @relation("OrderCreatedOnBehalf")
  orderEvents     OrderEvent[]           @relation("OrderEventBy")
  deliveryOffers  DeliveryOffer[]        @relation("CourierOffers")
  handovers       HandoverConfirmation[] @relation("HandoverBy")
  notifications   Notification[]

  ledgerAsBeneficiary LedgerEntry[]   @relation("LedgerBeneficiary")
  ledgerBy            LedgerEntry[]   @relation("LedgerBy")
  settlements         Settlement[]    @relation("SettlementSeller")
  settlementsVerified Settlement[]    @relation("SettlementVerifiedBy")
  settlementsApproved Settlement[]    @relation("SettlementApprovedBy")
  settlementsPaid     Settlement[]    @relation("SettlementPaidBy")
  cashOpened          CashSession[]   @relation("CashOpenedBy")
  cashClosed          CashSession[]   @relation("CashClosedBy")
  cashOperations      CashOperation[] @relation("CashOperationBy")
  expensesCreated     Expense[]       @relation("ExpenseCreatedBy")
  expensesApproved    Expense[]       @relation("ExpenseApprovedBy")
  expensesAsLeader    Expense[]       @relation("ExpenseLeader")
  bankBalances        BankBalance[]   @relation("BankBalanceBy")

  @@index([role])
  @@index([islandId])
  @@index([leaderId])
}

/// Historique des rattachements d'un vendeur (SELLER, TELECONSULTANT) à un leader.
model TeamAssignmentHistory {
  id           String   @id @default(cuid())
  userId       String
  fromLeaderId String?
  toLeaderId   String
  reason       String
  byId         String
  at           DateTime @default(now())

  user       User  @relation("AssignmentUser", fields: [userId], references: [id])
  fromLeader User? @relation("AssignmentFromLeader", fields: [fromLeaderId], references: [id])
  toLeader   User  @relation("AssignmentToLeader", fields: [toLeaderId], references: [id])
  by         User  @relation("AssignmentBy", fields: [byId], references: [id])

  @@index([userId, at])
  @@index([toLeaderId])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  /// SHA-256 du jeton (le jeton brut n'est jamais stocké)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Jeton qui a remplacé celui-ci lors d'une rotation
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Journal append-only : UPDATE et DELETE sont bloqués par un trigger (migration init).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  requestId String?
  at        DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId])
  @@index([at])
}

/// Paramètre versionné : la valeur lue est la plus récente avec effectiveFrom <= date.
model Setting {
  id            String   @id @default(cuid())
  key           String
  value         Json
  effectiveFrom DateTime @default(now())
  byId          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  by User? @relation(fields: [byId], references: [id])

  @@unique([key, effectiveFrom])
  @@index([key, effectiveFrom])
}

// ---------------------------------------------------------------------------
// Phase 2 – Catalogues, stock par site, achats en Chine
// ---------------------------------------------------------------------------

enum ShareType {
  FIXED
  PERCENT
}

enum StockMovementType {
  ENTRY
  RESERVE
  RELEASE
  OUT
  RETURN
  DAMAGED
  LOSS
  TRANSFER_OUT
  TRANSFER_IN
  ADJUST
  INVENTORY_DIFF
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  IN_TRANSIT
  ARRIVED
  IN_CUSTOMS
  RECEIVED
  CLOSED
}

enum InventoryStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum StockAlertType {
  LOW
  OUT
  UNSOLD
  INVENTORY_DIFF
}

/// Compteurs des numéros lisibles (LOT-014, PRD-000123…), incrémentés atomiquement.
model Counter {
  key   String @id
  value Int
}

/// Fiche produit d'un leader. Le même article chez deux leaders = deux Product.
model Product {
  id                String     @id @default(cuid())
  leaderId          String
  sku               String     @unique
  name              String
  category          String?
  description       String?
  quality           String?
  /// Clés S3 des photos (bucket products), 5 maximum
  photos            String[]   @default([])
  salePrice         Int
  /// Leader Senior : part e-commerçant
  sellerShareType   ShareType?
  sellerShareValue  Int?
  /// Leader Junior : prime TCI par produit vendu (bornée par tci.bonusMin / tci.bonusMax)
  tciBonus          Int?
  isPublished       Boolean    @default(false)
  lowStockThreshold Int?
  createdById       String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  leader         User            @relation("LeaderProducts", fields: [leaderId], references: [id])
  createdBy      User            @relation("ProductCreatedBy", fields: [createdById], references: [id])
  stockLevels    StockLevel[]
  movements      StockMovement[]
  lots           Lot[]
  purchaseOrders PurchaseOrder[]
  inventoryLines InventoryLine[]
  alerts         StockAlert[]
  orderItems     OrderItem[]

  @@index([leaderId, isPublished])
}

/// Niveau de stock matérialisé, modifié UNIQUEMENT par StockService (transaction + verrou de ligne).
model StockLevel {
  id        String   @id @default(cuid())
  productId String
  siteId    String
  available Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
  site    Site    @relation(fields: [siteId], references: [id])

  @@unique([productId, siteId])
  @@index([siteId])
}

/// Mouvement de stock append-only (UPDATE/DELETE bloqués par trigger).
model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  siteId      String
  type        StockMovementType
  /// Quantité positive ; le sens dépend du type
  quantity    Int
  lotId       String?
  /// Coût unitaire du lot concerné (KMF)
  unitCost    Int?
  orderId     String?
  transferId  String?
  inventoryId String?
  reason      String?
  byId        String
  at          DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id])
  site    Site    @relation(fields: [siteId], references: [id])
  lot     Lot?    @relation(fields: [lotId], references: [id])
  by      User    @relation("StockMovementBy", fields: [byId], references: [id])

  @@index([productId, siteId, at])
  @@index([orderId])
  @@index([transferId])
}

/// Lot : coût réel (achat + expédition + douane + frais) / quantité reçue. Consommé en FIFO.
model Lot {
  id              String   @id @default(cuid())
  number          String   @unique
  productId       String
  siteId          String
  purchaseOrderId String?
  /// Lot d'origine (transfert entre sites)
  parentLotId     String?
  quantity        Int
  remaining       Int
  unitCost        Int
  receivedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  product       Product         @relation(fields: [productId], references: [id])
  site          Site            @relation(fields: [siteId], references: [id])
  purchaseOrder PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  parentLot     Lot?            @relation("LotSplit", fields: [parentLotId], references: [id])
  children      Lot[]           @relation("LotSplit")
  movements     StockMovement[]

  @@index([productId, siteId, receivedAt])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  platform  String?
  contact   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id                    String              @id @default(cuid())
  number                String              @unique
  supplierId            String
  productId             String
  quantity              Int
  currency              String
  exchangeRate          Decimal             @db.Decimal(14, 6)
  purchaseAmountForeign Decimal             @db.Decimal(14, 2)
  purchaseAmountKmf     Int
  shippingKmf           Int                 @default(0)
  customsKmf            Int                 @default(0)
  otherFeesKmf          Int                 @default(0)
  destinationSiteId     String
  status                PurchaseOrderStatus @default(DRAFT)
  receivedQuantity      Int?
  /// Paiement fournisseur (écriture SUPPLIER_PAYMENT en phase 4)
  paidAmountKmf         Int?
  paidAt                DateTime?
  notes                 String?
  orderedAt             DateTime?
  inTransitAt           DateTime?
  arrivedAt             DateTime?
  inCustomsAt           DateTime?
  receivedAt            DateTime?
  closedAt              DateTime?
  createdById           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  supplier        Supplier @relation(fields: [supplierId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])
  destinationSite Site     @relation(fields: [destinationSiteId], references: [id])
  createdBy       User     @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  lots            Lot[]

  @@index([status])
}

model Inventory {
  id          String          @id @default(cuid())
  siteId      String
  status      InventoryStatus @default(OPEN)
  startedById String
  closedById  String?
  startedAt   DateTime        @default(now())
  closedAt    DateTime?

  site      Site            @relation(fields: [siteId], references: [id])
  startedBy User            @relation("InventoryStartedBy", fields: [startedById], references: [id])
  closedBy  User?           @relation("InventoryClosedBy", fields: [closedById], references: [id])
  lines     InventoryLine[]

  @@index([siteId, status])
}

model InventoryLine {
  id          String @id @default(cuid())
  inventoryId String
  productId   String
  /// Stock physique théorique (disponible + réservé) à l'ouverture
  expected    Int
  counted     Int?
  difference  Int?

  inventory Inventory @relation(fields: [inventoryId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([inventoryId, productId])
}

/// Alertes persistées (invendus : job quotidien ; écarts d'inventaire). Faible / rupture : calcul direct.
model StockAlert {
  id         String         @id @default(cuid())
  type       StockAlertType
  productId  String
  siteId     String
  value      Int?
  detectedAt DateTime       @default(now())
  resolvedAt DateTime?

  product Product @relation(fields: [productId], references: [id])
  site    Site    @relation(fields: [siteId], references: [id])

  @@index([type, resolvedAt])
}

// ---------------------------------------------------------------------------
// Phase 3 – Commandes, livraisons par île, notifications
// ---------------------------------------------------------------------------

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  ASSIGNED
  OUT_FOR_DELIVERY
  HANDED_OVER
  SOLD
  DELIVERY_FAILED
  REFUSED
  RETURN_IN_PROGRESS
  RETURNED_TO_STOCK
  DAMAGED
  CANCELLED
}

enum DeliveryMode {
  TO_SELLER
  TO_CUSTOMER
  PICKUP
}

enum SellerType {
  SELLER
  TELECONSULTANT
}

enum OfferResponse {
  PENDING
  ACCEPTED
  TAKEN_BY_OTHER
  IGNORED
  EXPIRED
}

enum HandoverKind {
  PICKUP_FROM_SITE
  TO_SELLER
  TO_CUSTOMER
  SELLER_RECEIVED
  SITE_HANDOVER
}

enum NotificationChannel {
  IN_APP
  PUSH
  SMS
  WHATSAPP
}

model Order {
  id                    String       @id @default(cuid())
  number                String       @unique
  sellerId              String
  sellerType            SellerType
  leaderId              String
  campaignId            String?
  prospectId            String?
  islandId              String
  siteId                String
  customerName          String
  customerPhone         String
  customerAddress       String?
  zone                  String?
  deliveryMode          DeliveryMode
  status                OrderStatus  @default(NEW)
  courierId             String?
  failReason            String?
  refuseReason          String?
  cancelReason          String?
  note                  String?
  amountCollected       Int?
  proofKey              String?
  /// Frais de course figé à la remise (delivery.feePerRun), écriture en phase 4
  courierFee            Int?
  /// Argent encaissé par le livreur remis à la caisse (opération de caisse)
  remittedAt            DateTime?
  remittanceOperationId String?
  createdOnBehalfById   String?
  confirmedAt           DateTime?
  preparingAt           DateTime?
  readyAt               DateTime?
  assignedAt            DateTime?
  outForDeliveryAt      DateTime?
  handedOverAt          DateTime?
  soldAt                DateTime?
  failedAt              DateTime?
  refusedAt             DateTime?
  returnStartedAt       DateTime?
  returnClosedAt        DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  seller          User                   @relation("OrderSeller", fields: [sellerId], references: [id])
  leader          User                   @relation("OrderLeader", fields: [leaderId], references: [id])
  courier         User?                  @relation("OrderCourier", fields: [courierId], references: [id])
  createdOnBehalf User?                  @relation("OrderCreatedOnBehalf", fields: [createdOnBehalfById], references: [id])
  island          Island                 @relation(fields: [islandId], references: [id])
  site            Site                   @relation(fields: [siteId], references: [id])
  items           OrderItem[]
  events          OrderEvent[]
  offers          DeliveryOffer[]
  confirmations   HandoverConfirmation[]
  ledgerEntries   LedgerEntry[]

  @@index([status, islandId])
  @@index([sellerId])
  @@index([leaderId])
  @@index([courierId])
  @@index([createdAt])
}

/// Ligne de commande avec instantanés figés à la création (règle 3) ; unitCost figé à la sortie (FIFO).
model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  unitPrice   Int
  sellerShare Int?
  sellerTax   Int    @default(0)
  digecomTax  Int    @default(0)
  tciBonus    Int?
  unitCost    Int?

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

/// Frise de la commande (append-only).
model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  action     String
  byId       String?
  role       Role?
  note       String?
  at         DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id])
  by    User? @relation("OrderEventBy", fields: [byId], references: [id])

  @@index([orderId, at])
}

model DeliveryOffer {
  id          String        @id @default(cuid())
  orderId     String
  courierId   String
  sentAt      DateTime      @default(now())
  response    OfferResponse @default(PENDING)
  respondedAt DateTime?

  order   Order @relation(fields: [orderId], references: [id])
  courier User  @relation("CourierOffers", fields: [courierId], references: [id])

  @@unique([orderId, courierId])
  @@index([courierId, response])
}

model HandoverConfirmation {
  id              String       @id @default(cuid())
  orderId         String
  kind            HandoverKind
  byId            String
  amountCollected Int?
  proofKey        String?
  at              DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id])
  by    User  @relation("HandoverBy", fields: [byId], references: [id])

  @@unique([orderId, kind])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  payload   Json?
  channel   NotificationChannel @default(IN_APP)
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 4 – Finance : grand livre, règlements, caisse, dépenses
// ---------------------------------------------------------------------------

enum LedgerType {
  SALE_REVENUE
  COGS
  DIGECOM_TAX
  SELLER_TAX
  SELLER_COMMISSION
  TCI_BONUS
  SUBSCRIPTION
  COURIER_FEE
  EXPENSE
  SUPPLIER_PAYMENT
  SETTLEMENT_PAYMENT
  CASH_IN
  CASH_OUT
  CORRECTION
}

enum SettlementStatus {
  GENERATED
  VERIFIED
  APPROVED
  PAID
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashDirection {
  IN
  OUT
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Grand livre append-only : jamais d'UPDATE ni de DELETE (trigger). Correction = écriture inverse liée.
model LedgerEntry {
  id              String     @id @default(cuid())
  type            LedgerType
  /// Montant signé (une correction porte le montant opposé de l'écriture corrigée)
  amount          Int
  orderId         String?
  beneficiaryId   String?
  islandId        String
  leaderId        String?
  campaignId      String?
  purchaseOrderId String?
  expenseId       String?
  cashOperationId String?
  settlementId    String?
  /// Jour métier de rattachement (00:00 heure des Comores, en UTC)
  periodDate      DateTime
  reversalOfId    String?    @unique
  justification   String?
  byId            String?
  createdAt       DateTime   @default(now())

  order       Order?           @relation(fields: [orderId], references: [id])
  beneficiary User?            @relation("LedgerBeneficiary", fields: [beneficiaryId], references: [id])
  island      Island           @relation(fields: [islandId], references: [id])
  reversalOf  LedgerEntry?     @relation("LedgerReversal", fields: [reversalOfId], references: [id])
  reversedBy  LedgerEntry?     @relation("LedgerReversal")
  by          User?            @relation("LedgerBy", fields: [byId], references: [id])
  lines       SettlementLine[]

  @@index([type, periodDate])
  @@index([beneficiaryId, type])
  @@index([orderId])
  @@index([islandId, periodDate])
}

model Settlement {
  id              String           @id @default(cuid())
  number          String           @unique
  sellerId        String
  islandId        String
  periodStart     DateTime
  periodEnd       DateTime
  salesCount      Int
  grossCommission Int
  taxes           Int
  subscriptions   Int
  otherDeductions Int              @default(0)
  carriedOver     Int              @default(0)
  /// Solde du cycle (peut être négatif ; reporté au cycle suivant)
  balance         Int
  netToPay        Int
  status          SettlementStatus @default(GENERATED)
  verifiedById    String?
  verifiedAt      DateTime?
  approvedById    String?
  approvedAt      DateTime?
  paidById        String?
  paidAt          DateTime?
  paymentMethod   String?
  paymentRef      String?
  proofKey        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  seller     User             @relation("SettlementSeller", fields: [sellerId], references: [id])
  island     Island           @relation(fields: [islandId], references: [id])
  verifiedBy User?            @relation("SettlementVerifiedBy", fields: [verifiedById], references: [id])
  approvedBy User?            @relation("SettlementApprovedBy", fields: [approvedById], references: [id])
  paidBy     User?            @relation("SettlementPaidBy", fields: [paidById], references: [id])
  lines      SettlementLine[]

  @@unique([sellerId, periodStart])
  @@index([status])
}

model SettlementLine {
  id            String @id @default(cuid())
  settlementId  String
  ledgerEntryId String @unique

  settlement  Settlement  @relation(fields: [settlementId], references: [id])
  ledgerEntry LedgerEntry @relation(fields: [ledgerEntryId], references: [id])
}

model CashRegister {
  id        String   @id @default(cuid())
  siteId    String   @unique
  createdAt DateTime @default(now())

  site     Site          @relation(fields: [siteId], references: [id])
  sessions CashSession[]
}

model CashSession {
  id             String            @id @default(cuid())
  registerId     String
  status         CashSessionStatus @default(OPEN)
  openedById     String
  openingAmount  Int
  expectedAmount Int?
  countedAmount  Int?
  difference     Int?
  closingNote    String?
  closedById     String?
  openedAt       DateTime          @default(now())
  closedAt       DateTime?

  register   CashRegister    @relation(fields: [registerId], references: [id])
  openedBy   User            @relation("CashOpenedBy", fields: [openedById], references: [id])
  closedBy   User?           @relation("CashClosedBy", fields: [closedById], references: [id])
  operations CashOperation[]

  @@index([registerId, status])
}

model CashOperation {
  id           String        @id @default(cuid())
  sessionId    String
  direction    CashDirection
  category     String
  amount       Int
  label        String?
  orderIds     String[]      @default([])
  courierId    String?
  settlementId String?
  expenseId    String?
  sellerId     String?
  proofKey     String?
  byId         String
  at           DateTime      @default(now())

  session CashSession @relation(fields: [sessionId], references: [id])
  by      User        @relation("CashOperationBy", fields: [byId], references: [id])

  @@index([sessionId])
}

model Expense {
  id           String        @id @default(cuid())
  category     String
  label        String
  amount       Int
  islandId     String
  periodDate   DateTime
  campaignId   String?
  leaderId     String?
  proofKey     String?
  status       ExpenseStatus @default(PENDING)
  rejectReason String?
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  island     Island @relation(fields: [islandId], references: [id])
  createdBy  User   @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  approvedBy User?  @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  leader     User?  @relation("ExpenseLeader", fields: [leaderId], references: [id])

  @@index([status, periodDate])
}

model BankBalance {
  id        String   @id @default(cuid())
  date      DateTime
  amount    Int
  source    String
  byId      String
  createdAt DateTime @default(now())

  by User @relation("BankBalanceBy", fields: [byId], references: [id])

  @@index([date])
}

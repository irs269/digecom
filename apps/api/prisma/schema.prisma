// Schéma Prisma – Dig'eCom. Guide : docs/DATA-MODEL.md
// Montants en Int (KMF). Identifiants cuid(). Dates en UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FINANCE_MANAGER
  ACCOUNTANT
  ACCOUNTANT_ASSISTANT
  CASHIER
  STOCK_MANAGER
  LOGISTICS_ASSISTANT
  LEADER_SENIOR
  LEADER_JUNIOR
  TELECONSULTANT
  SELLER
  COURIER
}

enum IslandCode {
  GC
  AN
  MO
}

enum SiteType {
  SHOP
  WAREHOUSE
}

model Island {
  id        String     @id @default(cuid())
  code      IslandCode @unique
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  sites Site[]
  users User[]
}

model Site {
  id        String   @id @default(cuid())
  name      String   @unique
  type      SiteType
  islandId  String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  island Island @relation(fields: [islandId], references: [id])
  users  User[]

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  lots           Lot[]
  purchaseOrders PurchaseOrder[]
  inventories    Inventory[]
  stockAlerts    StockAlert[]

  @@index([islandId])
}

model User {
  id                 String    @id @default(cuid())
  fullName           String
  phone              String    @unique
  email              String?   @unique
  passwordHash       String
  role               Role
  islandId           String?
  siteId             String?
  /// Leader de rattachement (SELLER, TELECONSULTANT)
  leaderId           String?
  isActive           Boolean   @default(true)
  /// Disponibilité (COURIER)
  isAvailable        Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  island        Island?        @relation(fields: [islandId], references: [id])
  site          Site?          @relation(fields: [siteId], references: [id])
  leader        User?          @relation("LeaderTeam", fields: [leaderId], references: [id])
  team          User[]         @relation("LeaderTeam")
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  settings      Setting[]

  teamHistory       TeamAssignmentHistory[] @relation("AssignmentUser")
  leftTeams         TeamAssignmentHistory[] @relation("AssignmentFromLeader")
  joinedTeams       TeamAssignmentHistory[] @relation("AssignmentToLeader")
  assignmentsMadeBy TeamAssignmentHistory[] @relation("AssignmentBy")

  products           Product[]       @relation("LeaderProducts")
  productsCreated    Product[]       @relation("ProductCreatedBy")
  stockMovements     StockMovement[] @relation("StockMovementBy")
  purchaseOrders     PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  inventoriesStarted Inventory[]     @relation("InventoryStartedBy")
  inventoriesClosed  Inventory[]     @relation("InventoryClosedBy")

  @@index([role])
  @@index([islandId])
  @@index([leaderId])
}

/// Historique des rattachements d'un vendeur (SELLER, TELECONSULTANT) à un leader.
model TeamAssignmentHistory {
  id           String   @id @default(cuid())
  userId       String
  fromLeaderId String?
  toLeaderId   String
  reason       String
  byId         String
  at           DateTime @default(now())

  user       User  @relation("AssignmentUser", fields: [userId], references: [id])
  fromLeader User? @relation("AssignmentFromLeader", fields: [fromLeaderId], references: [id])
  toLeader   User  @relation("AssignmentToLeader", fields: [toLeaderId], references: [id])
  by         User  @relation("AssignmentBy", fields: [byId], references: [id])

  @@index([userId, at])
  @@index([toLeaderId])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  /// SHA-256 du jeton (le jeton brut n'est jamais stocké)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Jeton qui a remplacé celui-ci lors d'une rotation
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Journal append-only : UPDATE et DELETE sont bloqués par un trigger (migration init).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  requestId String?
  at        DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId])
  @@index([at])
}

/// Paramètre versionné : la valeur lue est la plus récente avec effectiveFrom <= date.
model Setting {
  id            String   @id @default(cuid())
  key           String
  value         Json
  effectiveFrom DateTime @default(now())
  byId          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  by User? @relation(fields: [byId], references: [id])

  @@unique([key, effectiveFrom])
  @@index([key, effectiveFrom])
}

// ---------------------------------------------------------------------------
// Phase 2 – Catalogues, stock par site, achats en Chine
// ---------------------------------------------------------------------------

enum ShareType {
  FIXED
  PERCENT
}

enum StockMovementType {
  ENTRY
  RESERVE
  RELEASE
  OUT
  RETURN
  DAMAGED
  LOSS
  TRANSFER_OUT
  TRANSFER_IN
  ADJUST
  INVENTORY_DIFF
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  IN_TRANSIT
  ARRIVED
  IN_CUSTOMS
  RECEIVED
  CLOSED
}

enum InventoryStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum StockAlertType {
  LOW
  OUT
  UNSOLD
  INVENTORY_DIFF
}

/// Compteurs des numéros lisibles (LOT-014, PRD-000123…), incrémentés atomiquement.
model Counter {
  key   String @id
  value Int
}

/// Fiche produit d'un leader. Le même article chez deux leaders = deux Product.
model Product {
  id                String     @id @default(cuid())
  leaderId          String
  sku               String     @unique
  name              String
  category          String?
  description       String?
  quality           String?
  /// Clés S3 des photos (bucket products), 5 maximum
  photos            String[]   @default([])
  salePrice         Int
  /// Leader Senior : part e-commerçant
  sellerShareType   ShareType?
  sellerShareValue  Int?
  /// Leader Junior : prime TCI par produit vendu (bornée par tci.bonusMin / tci.bonusMax)
  tciBonus          Int?
  isPublished       Boolean    @default(false)
  lowStockThreshold Int?
  createdById       String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  leader         User            @relation("LeaderProducts", fields: [leaderId], references: [id])
  createdBy      User            @relation("ProductCreatedBy", fields: [createdById], references: [id])
  stockLevels    StockLevel[]
  movements      StockMovement[]
  lots           Lot[]
  purchaseOrders PurchaseOrder[]
  inventoryLines InventoryLine[]
  alerts         StockAlert[]

  @@index([leaderId, isPublished])
}

/// Niveau de stock matérialisé, modifié UNIQUEMENT par StockService (transaction + verrou de ligne).
model StockLevel {
  id        String   @id @default(cuid())
  productId String
  siteId    String
  available Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
  site    Site    @relation(fields: [siteId], references: [id])

  @@unique([productId, siteId])
  @@index([siteId])
}

/// Mouvement de stock append-only (UPDATE/DELETE bloqués par trigger).
model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  siteId      String
  type        StockMovementType
  /// Quantité positive ; le sens dépend du type
  quantity    Int
  lotId       String?
  /// Coût unitaire du lot concerné (KMF)
  unitCost    Int?
  orderId     String?
  transferId  String?
  inventoryId String?
  reason      String?
  byId        String
  at          DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id])
  site    Site    @relation(fields: [siteId], references: [id])
  lot     Lot?    @relation(fields: [lotId], references: [id])
  by      User    @relation("StockMovementBy", fields: [byId], references: [id])

  @@index([productId, siteId, at])
  @@index([orderId])
  @@index([transferId])
}

/// Lot : coût réel (achat + expédition + douane + frais) / quantité reçue. Consommé en FIFO.
model Lot {
  id              String   @id @default(cuid())
  number          String   @unique
  productId       String
  siteId          String
  purchaseOrderId String?
  /// Lot d'origine (transfert entre sites)
  parentLotId     String?
  quantity        Int
  remaining       Int
  unitCost        Int
  receivedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  product       Product         @relation(fields: [productId], references: [id])
  site          Site            @relation(fields: [siteId], references: [id])
  purchaseOrder PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  parentLot     Lot?            @relation("LotSplit", fields: [parentLotId], references: [id])
  children      Lot[]           @relation("LotSplit")
  movements     StockMovement[]

  @@index([productId, siteId, receivedAt])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  platform  String?
  contact   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id                    String              @id @default(cuid())
  number                String              @unique
  supplierId            String
  productId             String
  quantity              Int
  currency              String
  exchangeRate          Decimal             @db.Decimal(14, 6)
  purchaseAmountForeign Decimal             @db.Decimal(14, 2)
  purchaseAmountKmf     Int
  shippingKmf           Int                 @default(0)
  customsKmf            Int                 @default(0)
  otherFeesKmf          Int                 @default(0)
  destinationSiteId     String
  status                PurchaseOrderStatus @default(DRAFT)
  receivedQuantity      Int?
  /// Paiement fournisseur (écriture SUPPLIER_PAYMENT en phase 4)
  paidAmountKmf         Int?
  paidAt                DateTime?
  notes                 String?
  orderedAt             DateTime?
  inTransitAt           DateTime?
  arrivedAt             DateTime?
  inCustomsAt           DateTime?
  receivedAt            DateTime?
  closedAt              DateTime?
  createdById           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  supplier        Supplier @relation(fields: [supplierId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])
  destinationSite Site     @relation(fields: [destinationSiteId], references: [id])
  createdBy       User     @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  lots            Lot[]

  @@index([status])
}

model Inventory {
  id          String          @id @default(cuid())
  siteId      String
  status      InventoryStatus @default(OPEN)
  startedById String
  closedById  String?
  startedAt   DateTime        @default(now())
  closedAt    DateTime?

  site      Site            @relation(fields: [siteId], references: [id])
  startedBy User            @relation("InventoryStartedBy", fields: [startedById], references: [id])
  closedBy  User?           @relation("InventoryClosedBy", fields: [closedById], references: [id])
  lines     InventoryLine[]

  @@index([siteId, status])
}

model InventoryLine {
  id          String @id @default(cuid())
  inventoryId String
  productId   String
  /// Stock physique théorique (disponible + réservé) à l'ouverture
  expected    Int
  counted     Int?
  difference  Int?

  inventory Inventory @relation(fields: [inventoryId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([inventoryId, productId])
}

/// Alertes persistées (invendus : job quotidien ; écarts d'inventaire). Faible / rupture : calcul direct.
model StockAlert {
  id         String         @id @default(cuid())
  type       StockAlertType
  productId  String
  siteId     String
  value      Int?
  detectedAt DateTime       @default(now())
  resolvedAt DateTime?

  product Product @relation(fields: [productId], references: [id])
  site    Site    @relation(fields: [siteId], references: [id])

  @@index([type, resolvedAt])
}

# =============================================================================
# Dig'eCom – variables d'environnement (développement)
# Copie ce fichier :  cp .env.example .env   puis adapte les valeurs.
# Ne commite JAMAIS le fichier .env. Les valeurs ci-dessous sont des valeurs de
# développement local uniquement : change-les toutes en production.
# =============================================================================

# --- Projet Docker Compose ----------------------------------------------------
COMPOSE_PROJECT_NAME=digecom

# --- PostgreSQL 16 -------------------------------------------------------------
POSTGRES_USER=digecom
POSTGRES_PASSWORD=change-moi-en-local
POSTGRES_DB=digecom
# Port publié sur ta machine (pour un client SQL). Le conteneur api utilise 5432.
POSTGRES_PORT=5432

# --- Redis 7 -------------------------------------------------------------------
REDIS_PORT=6379

# --- MinIO (stockage S3 compatible) -------------------------------------------
MINIO_ROOT_USER=digecom
MINIO_ROOT_PASSWORD=change-moi-en-local-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- API (NestJS) --------------------------------------------------------------
API_PORT=4000
# Secret de signature des JWT d'accès : 32 caractères minimum.
# Génère-le avec :  openssl rand -base64 48
JWT_ACCESS_SECRET=remplace-moi-par-un-secret-aleatoire-de-48-caracteres
# Durée du jeton d'accès (secondes) : 15 min.
JWT_ACCESS_TTL_SECONDS=900
# Durée du refresh token (jours).
REFRESH_TOKEN_TTL_DAYS=30
# Cookie `Secure` : false uniquement en dev sur http://localhost. Toujours true en prod (HTTPS).
COOKIE_SECURE=false
# Swagger (/api/docs) : activé par défaut hors production.
SWAGGER_ENABLED=true
# Connexion : 5 essais / 15 min par IP + téléphone ; verrouillage 15 min après 5 échecs.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOCKOUT_MINUTES=15
LOG_LEVEL=info
# Simulateur livreur / vendeur dans le back-office (admin, dev uniquement). false en production.
DEV_TOOLS_ENABLED=true

# --- Web (Next.js) -------------------------------------------------------------
WEB_PORT=3000
# Origine autorisée par le CORS de l'API.
WEB_ORIGIN=http://localhost:3000
# URL de l'API vue par le navigateur : passe par le rewrite Next.js /api -> api:4000.
NEXT_PUBLIC_API_URL=/api

# --- Seed (make seed) ----------------------------------------------------------
# Mot de passe commun des comptes de démonstration (voir README).
SEED_DEFAULT_PASSWORD=Digecom2026!
# true en production : chaque compte seedé doit changer son mot de passe.
SEED_FORCE_PASSWORD_CHANGE=false

# Web Push (PWA iPhone) : `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@digecom.km

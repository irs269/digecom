# =============================================================================
# Dig'eCom – PRODUCTION (VPS, derrière le Nginx de l'hôte). Voir docs/DEPLOY.md.
#   cp .env.production.example .env && chmod 600 .env
# Ne commite JAMAIS le fichier .env. Remplace chaque valeur « A-GENERER-… » par le résultat de la
# commande indiquée : l'API refuse de démarrer tant qu'une valeur d'exemple reste en place.
# Les mots de passe sont en hexadécimal (openssl rand -hex) : sûrs dans les URL de connexion.
# =============================================================================

COMPOSE_PROJECT_NAME=digecom-prod
NODE_ENV=production
# Tag local des images construites (ex. le commit : git rev-parse --short HEAD).
IMAGE_TAG=latest

# --- Domaines (HTTPS par Nginx + Certbot sur l'hôte) ---------------------------
# Back-office (sans « / » final).
WEB_ORIGIN=https://digecom.example.km
# Sous-domaine des fichiers (photos, preuves, exports) : URL pré-signées MinIO.
S3_PUBLIC_ENDPOINT=https://fichiers.digecom.example.km

# --- Ports publiés sur 127.0.0.1 uniquement (relayés par Nginx) ----------------
# Déjà pris sur le serveur : 22, 80, 443, 3000, 5432, 8069, 8071, 8080, 8090.
WEB_PORT=3100
MINIO_PORT=9100

# --- Sécurité ------------------------------------------------------------------
COOKIE_SECURE=true
SWAGGER_ENABLED=false
DEV_TOOLS_ENABLED=false
# Nginx (hôte) → Next.js → API : 2 proxys de confiance (IP réelle du visiteur).
TRUST_PROXY=2
# Connexion : 5 essais / 15 min par IP + téléphone, verrouillage 15 min.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOCKOUT_MINUTES=15
LOG_LEVEL=info

# --- PostgreSQL ----------------------------------------------------------------
# Propriétaire du schéma (migrations).
POSTGRES_USER=digecom
# openssl rand -hex 24
POSTGRES_PASSWORD=A-GENERER-openssl-rand-hex-24
POSTGRES_DB=digecom
# Rôle applicatif de l'API (sans DDL, sans UPDATE/DELETE sur AuditLog, LedgerEntry…).
APP_DB_USER=digecom_app
# openssl rand -hex 24
APP_DB_PASSWORD=A-GENERER-openssl-rand-hex-24

# --- Redis ---------------------------------------------------------------------
# openssl rand -hex 24
REDIS_PASSWORD=A-GENERER-openssl-rand-hex-24

# --- API -----------------------------------------------------------------------
# openssl rand -hex 48
JWT_ACCESS_SECRET=A-GENERER-openssl-rand-hex-48
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- MinIO (stockage S3) -------------------------------------------------------
# openssl rand -hex 10
S3_ACCESS_KEY=A-GENERER-openssl-rand-hex-10
# openssl rand -hex 24
S3_SECRET_KEY=A-GENERER-openssl-rand-hex-24
S3_REGION=us-east-1

# --- Sauvegardes (scripts/backup.sh) -------------------------------------------
BACKUP_DIR=/var/backups/digecom
BACKUP_KEEP_DAYS=14
